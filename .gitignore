# virtualenvs / caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# papers: fetched on demand by scripts/fetch_papers.sh (copyright + repo size)
pdfs/*.pdf
pdfs/txt/

